# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Data and checkpoints
data/*.npz
runs/*

# Un-ignore memory_ring_full results (config, metrics, history, effectome, figures)
!runs/memory_ring_full/
